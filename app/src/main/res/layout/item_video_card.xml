<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/videoCardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Video Thumbnail -->
    <androidx.cardview.widget.CardView
        android:layout_width="100dp"
        android:layout_height="64dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#202233"
        app:cardElevation="0dp">

        <ImageView
            android:id="@+id/imgVideoThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_video"
            app:tint="@color/ios_purple" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtVideoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do Clipe.mp4"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/txtVideoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="03:45"
            android:textColor="@color/ios_cyan"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/imgNowPlayingIndicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_play"
        android:visibility="gone"
        app:tint="@color/ios_cyan" />

</LinearLayout>
