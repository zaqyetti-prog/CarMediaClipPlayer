<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:padding="20dp">

    <!-- Dialog Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackFolder"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_back"
            android:visibility="gone"
            app:tint="@color/text_primary"
            android:contentDescription="Voltar" />

        <TextView
            android:id="@+id/txtDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="@string/title_folders"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ios_cyan"
            android:textSize="15sp"
            android:layout_marginEnd="16dp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseBrowser"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"
            android:contentDescription="@string/btn_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#26FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <!-- Two-panel layout or ViewFlipper for Pastas vs Clipes -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Folders View (Large Grid for Car Screen) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFolders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="6dp" />

        <!-- Videos View (Inside selected folder) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVideos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="6dp"
            android:visibility="gone" />

        <!-- Empty state message -->
        <TextView
            android:id="@+id/txtEmptyBrowser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_usb_found"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:gravity="center"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
