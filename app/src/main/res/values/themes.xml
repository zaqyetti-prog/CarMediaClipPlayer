<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CarMediaClipPlayer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/ios_cyan</item>
        <item name="colorPrimaryVariant">@color/ios_blue</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        
        <item name="colorSecondary">@color/ios_purple</item>
        <item name="colorSecondaryVariant">@color/ios_pink</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        
        <item name="android:windowBackground">@color/bg_midnight</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- Glass Dialog Theme -->
    <style name="DialogGlassTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
